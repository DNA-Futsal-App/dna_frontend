{
  "name": "dna-futsal-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run teams:display-manifest && npm run logos:manifest",
    "dev": "next dev",
    "prebuild": "npm run teams:display-manifest && npm run logos:manifest",
    "build": "next build --webpack",
    "start": "next start",
    "prelint": "npm run teams:display-manifest",
    "lint": "eslint .",
    "pretypecheck": "npm run teams:display-manifest",
    "typecheck": "tsc --noEmit",
    "teams:display-manifest": "node scripts/generate-team-display-manifest.mjs",
    "logos:manifest": "node scripts/generate-team-logo-manifest.mjs",
    "logos:test": "node --test scripts/team-logos.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
