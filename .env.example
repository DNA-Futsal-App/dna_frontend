# URL interna do backend Java. No navegador, a comunicação passa pelo BFF do Next.
DNA_API_URL=http://localhost:8080

# Opcional: origem pública exata do frontend atrás de proxy reverso/TLS.
# Defina em produção se o proxy não preservar o cabeçalho Host público.
# Exemplo: DNA_PUBLIC_ORIGIN=https://app.seu-dominio.com.br
# Nunca configure como * nem como URL interna da rede Docker.

# Ative somente para QA visual local sem o backend em execução.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
